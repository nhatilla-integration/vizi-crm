# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)

REACT_APP_SUPABASE_URL=https://SEU-PROJETO.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sua-chave-publishable-aqui

# Mesmos valores, sem prefixo REACT_APP_ — usados só por api/metrics-assistant.js
# (função serverless, nunca vai pro bundle do navegador) pra validar o token
# do usuário e controlar o limite diário de perguntas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-publishable-aqui

# Chave da API da Anthropic, usada pelo Assistente de Métricas (api/metrics-assistant.js).
# Sem o prefixo REACT_APP_ de propósito: essa chave é secreta e só pode ser lida
# pela função serverless, nunca pelo navegador. Gere em console.anthropic.com.
ANTHROPIC_API_KEY=sua-chave-da-anthropic-aqui